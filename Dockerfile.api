FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore PdvSistema.API/PdvSistema.API.csproj
RUN dotnet publish PdvSistema.API/PdvSistema.API.csproj -c Release --no-restore -o /app/publish /p:UseAppHost=false

FROM build AS migrations
RUN dotnet tool install --tool-path /tools dotnet-ef --version 10.0.12
ENV PATH="/tools:${PATH}"
ENTRYPOINT ["dotnet", "ef", "database", "update", "--project", "PdvSistema.Infrastructure/PdvSistema.Infrastructure.csproj", "--startup-project", "PdvSistema.API/PdvSistema.API.csproj", "--configuration", "Release"]

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "PdvSistema.API.dll"]