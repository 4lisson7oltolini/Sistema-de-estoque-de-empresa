@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-area">
        <header class="topbar">
            <div class="topbar-context">
                <span class="topbar-kicker">PAINEL OPERACIONAL</span>
                <span class="topbar-title">Sistema de estoque</span>
            </div>
            <AuthorizeView>
                <Authorized>
                    <div class="operator-mark" title="Conta autenticada">OK</div>
                </Authorized>
                <NotAuthorized>
                    <a class="button button-quiet" href="/login">Entrar</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <div class="page-content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro inesperado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>
