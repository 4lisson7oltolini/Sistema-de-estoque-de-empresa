<div class="brand-lockup">
    <a class="brand-mark" href="/" aria-label="Página inicial">P</a>
    <div class="brand-copy">
        <span class="brand-name">Ponto</span>
        <span class="brand-caption">GESTÃO DE ESTOQUE</span>
    </div>
</div>

<AuthorizeView>
    <Authorized Context="authState">
        <nav class="side-navigation" aria-label="Navegação principal">
            <span class="nav-section-label">VISÃO GERAL</span>
            <NavLink class="side-link" href="/" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="7" height="7" rx="1" /><rect x="13.5" y="3.5" width="7" height="7" rx="1" /><rect x="3.5" y="13.5" width="7" height="7" rx="1" /><rect x="13.5" y="13.5" width="7" height="7" rx="1" /></svg>
                Painel
            </NavLink>

            <span class="nav-section-label nav-section-spaced">OPERAÇÃO</span>
            <NavLink class="side-link" href="/vendas">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 9h8M8 13h3" /><path d="m15 15 2 2 4-4" /></svg>
                Vendas
            </NavLink>
            <NavLink class="side-link" href="/movimentacoes">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h12l-3-3M17 17H5l3 3M19 7l-3 3M5 17l3-3" /></svg>
                Movimentações
            </NavLink>

            <span class="nav-section-label nav-section-spaced">CADASTROS</span>
            <NavLink class="side-link" href="/produtos">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 7 8-4 8 4v10l-8 4-8-4V7Z" /><path d="m4 7 8 4 8-4M12 11v10M8 5l8 4" /></svg>
                Produtos
            </NavLink>
            <NavLink class="side-link" href="/categorias">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h6l2 2h8v11H4v-13Z" /><path d="M4 8h16" /></svg>
                Categorias
            </NavLink>
            <NavLink class="side-link" href="/clientes">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3.5 20v-1.5a5.5 5.5 0 0 1 11 0V20ZM16 5.5a3 3 0 0 1 0 5.8M18 14a4 4 0 0 1 2.5 3.7V20" /></svg>
                Clientes
            </NavLink>

            <span class="nav-section-label nav-section-spaced">ANÁLISES</span>
            <NavLink class="side-link" href="/relatorios">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5M4 19h16M8 16v-4m4 4V8m4 8v-6m4 6V5" /></svg>
                Relatórios
            </NavLink>
            <button class="side-link side-logout" @onclick="SairAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3" /><path d="M12 3h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" /></svg>
                Sair
            </button>
        </nav>
        <div class="sidebar-footer">
            <span class="footer-pulse"></span>
            <div><strong>@authState.User.Identity?.Name</strong><small>@authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small></div>
        </div>
    </Authorized>
    <NotAuthorized>
        <nav class="side-navigation" aria-label="Navegação principal">
            <NavLink class="side-link" href="/login">Entrar</NavLink>
            <NavLink class="side-link" href="/primeiro-acesso">Primeiro acesso</NavLink>
        </nav>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private PdvAuthenticationStateProvider AuthState { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private async Task SairAsync()
    {
        await AuthState.EncerrarSessaoAsync();
        Navigation.NavigateTo("/login");
    }
}


